        <rdfs:comment xml:lang="fr">Milieu(x) de vie de l&apos;espece. Cardinalite : 1..*.</rdfs:comment>
        <rdfs:label xml:lang="fr">vitDans</rdfs:label>
    </owl:ObjectProperty>
    



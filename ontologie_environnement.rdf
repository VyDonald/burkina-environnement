        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="fr">Nom scientifique latin ; cle (owl:hasKey) : deux individus portant le meme nom scientifique designent la meme espece.</rdfs:comment>
        <rdfs:label xml:lang="fr">nomScientifique</rdfs:label>
    </owl:DatatypeProperty>
    



        <rdfs:label xml:lang="fr">ancienNom</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/burkina-environnement#appellationLocale -->

    <owl:DatatypeProperty rdf:about="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#appellationLocale">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#Appellation"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>

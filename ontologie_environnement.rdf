        <rdfs:range rdf:resource="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#Pathologie"/>
        <rdfs:comment xml:lang="fr">Pathologie traditionnellement soignee. Cardinalite : 1..*.</rdfs:comment>
        <rdfs:label xml:lang="fr">soigne</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/burkina-environnement#soignePathologie -->


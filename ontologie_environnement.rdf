                    <rdf:Description rdf:about="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#Province"/>
                    <rdf:Description rdf:about="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#Region"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="fr">Chef-lieu de l&apos;entite.</rdfs:comment>
        <rdfs:label xml:lang="fr">chefLieu</rdfs:label>
    </owl:DatatypeProperty>
    



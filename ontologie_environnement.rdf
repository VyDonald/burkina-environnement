        <rdfs:comment xml:lang="fr">Date de creation de l&apos;entite.</rdfs:comment>
        <rdfs:label xml:lang="fr">dateCreation</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/burkina-environnement#dateModification -->

    <owl:DatatypeProperty rdf:about="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#dateModification">
        <rdfs:domain rdf:resource="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#Localite"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:comment xml:lang="fr">Horodatage de la derniere modification d&apos;une entite locale (tracabilite).</rdfs:comment>
        <rdfs:label xml:lang="fr">dateModification</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/burkina-environnement#dateObservation -->


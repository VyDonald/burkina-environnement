<?xml version="1.0"?>
<rdf:RDF xmlns="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#"
     xml:base="http://www.ibam-ujkz.bf/ontologies/burkina-environnement"
     xmlns:bf="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#"
     xmlns:geo="http://www.opengis.net/ont/geosparql#"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:skos="http://www.w3.org/2004/02/skos/core#"
     xmlns:swrl="http://www.w3.org/2003/11/swrl#"
     xmlns:swrlb="http://www.w3.org/2003/11/swrlb#"
     xmlns:dcterms="http://purl.org/dc/terms/">
    <owl:Ontology rdf:about="http://www.ibam-ujkz.bf/ontologies/burkina-environnement">
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-08-09</dcterms:created>
        <dcterms:creator xml:lang="fr">Groupe Environnement (Flore : Gr.1,21,28 ; Faune : Gr.25,35 ; Cours d&apos;eau : Gr.7,14) - IBAM/UJKZ</dcterms:creator>
        <rdfs:comment xml:lang="fr">Ontologie du lot Environnement (fusion des theme Flore, Faune, Cours d&apos;eau) du systeme OntoBurkina, restreinte a ce lot conformement aux instructions de fusion par lot. Concepts pivots partages avec les autres lots : Ethnie et Localite. Base sur le cahier des charges technique commun OntoBurkina et peuplee avec les donnees reelles collectees (Collecte_Donnees_OntoBurkina.xlsx).</rdfs:comment>
        <rdfs:label xml:lang="fr">OntoBurkina-Environnement</rdfs:label>
        <owl:versionInfo>1.0 - lot Environnement, peuple depuis Collecte_Donnees_OntoBurkina.xlsx</owl:versionInfo>
    </owl:Ontology>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Annotation properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://purl.org/dc/terms/created -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/created"/>
    


    <!-- http://purl.org/dc/terms/creator -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/creator"/>
    


    <!-- http://purl.org/dc/terms/source -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/source"/>
    


    <!-- http://www.w3.org/2003/11/swrl#argument1 -->

    <owl:AnnotationProperty rdf:about="http://www.w3.org/2003/11/swrl#argument1"/>
    


    <!-- http://www.w3.org/2003/11/swrl#argument2 -->

    <owl:AnnotationProperty rdf:about="http://www.w3.org/2003/11/swrl#argument2"/>
    


    <!-- http://www.w3.org/2003/11/swrl#arguments -->

    <owl:AnnotationProperty rdf:about="http://www.w3.org/2003/11/swrl#arguments"/>
    


    <!-- http://www.w3.org/2003/11/swrl#body -->

    <owl:AnnotationProperty rdf:about="http://www.w3.org/2003/11/swrl#body"/>
    


    <!-- http://www.w3.org/2003/11/swrl#builtin -->

    <owl:AnnotationProperty rdf:about="http://www.w3.org/2003/11/swrl#builtin"/>
    


    <!-- http://www.w3.org/2003/11/swrl#classPredicate -->

    <owl:AnnotationProperty rdf:about="http://www.w3.org/2003/11/swrl#classPredicate"/>
    


    <!-- http://www.w3.org/2003/11/swrl#head -->

    <owl:AnnotationProperty rdf:about="http://www.w3.org/2003/11/swrl#head"/>
    


    <!-- http://www.w3.org/2003/11/swrl#propertyPredicate -->

    <owl:AnnotationProperty rdf:about="http://www.w3.org/2003/11/swrl#propertyPredicate"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Datatypes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.w3.org/2001/XMLSchema#date -->

    <rdfs:Datatype rdf:about="http://www.w3.org/2001/XMLSchema#date"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.ibam-ujkz.bf/ontologies/burkina-environnement#aConditionCulture -->

    <owl:ObjectProperty rdf:about="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#aConditionCulture">
        <rdfs:domain rdf:resource="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#EspeceVegetale"/>
        <rdfs:range rdf:resource="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#TypeCulture"/>
        <rdfs:comment xml:lang="fr">Type de culture adapte a l&apos;espece. Cardinalite : 0..*.</rdfs:comment>
        <rdfs:label xml:lang="fr">aConditionCulture</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/burkina-environnement#aPourAffluent -->

    <owl:ObjectProperty rdf:about="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#aPourAffluent">
        <owl:inverseOf rdf:resource="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#affluentDe"/>
        <rdfs:domain rdf:resource="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#CoursEau"/>
        <rdfs:range rdf:resource="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#CoursEau"/>
        <rdfs:comment xml:lang="fr">Affluent(s) de ce cours d&apos;eau.</rdfs:comment>
        <rdfs:label xml:lang="fr">aPourAffluent</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/burkina-environnement#aPourAppellation -->

    <owl:ObjectProperty rdf:about="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#aPourAppellation">
        <owl:inverseOf rdf:resource="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#estAppellationDe"/>
        <rdfs:domain rdf:resource="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#CoursEau"/>
        <rdfs:range rdf:resource="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#Appellation"/>
        <rdfs:comment xml:lang="fr">Appellations locales et historiques. Cardinalite : 0..*.</rdfs:comment>
        <rdfs:label xml:lang="fr">aPourAppellation</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/burkina-environnement#aPourCaracteristique -->

    <owl:ObjectProperty rdf:about="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#aPourCaracteristique">
        <owl:inverseOf rdf:resource="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#estCaracteristiqueDe"/>
        <rdfs:domain rdf:resource="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#CoursEau"/>
        <rdfs:range rdf:resource="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#CaracteristiqueHydrologique"/>
        <rdfs:comment xml:lang="fr">Caracteristiques hydrologiques mesurees. Cardinalite : 0..*.</rdfs:comment>
        <rdfs:label xml:lang="fr">aPourCaracteristique</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/burkina-environnement#aPourCoursEau -->

    <owl:ObjectProperty rdf:about="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#aPourCoursEau">
        <owl:inverseOf rdf:resource="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#appartientAuBassin"/>
        <rdfs:domain rdf:resource="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#BassinVersant"/>
        <rdfs:range rdf:resource="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#CoursEau"/>
        <rdfs:comment xml:lang="fr">Cours d&apos;eau de ce bassin.</rdfs:comment>
        <rdfs:label xml:lang="fr">aPourCoursEau</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/burkina-environnement#aPourEthnie -->

    <owl:ObjectProperty rdf:about="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#aPourEthnie">
        <owl:inverseOf rdf:resource="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#estEthnieDe"/>
        <rdfs:domain rdf:resource="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#CoursEau"/>
        <rdfs:range rdf:resource="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#Ethnie"/>
        <rdfs:comment xml:lang="fr">Ethnies riveraines documentees (avec provenance obligatoire). Cardinalite : 0..*.</rdfs:comment>
        <rdfs:label xml:lang="fr">aPourEthnie</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/burkina-environnement#aPourMedia -->

    <owl:ObjectProperty rdf:about="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#aPourMedia">
        <owl:inverseOf rdf:resource="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#estMediaDe"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#CoursEau"/>
                    <rdf:Description rdf:about="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#EspeceAnimale"/>
                    <rdf:Description rdf:about="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#EspeceVegetale"/>
                    <rdf:Description rdf:about="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#Ethnie"/>
                    <rdf:Description rdf:about="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#Localite"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#Media"/>
        <rdfs:comment xml:lang="fr">Photos illustrant un element. Domaine restreint aux classes du lot Environnement (EspeceVegetale, EspeceAnimale, CoursEau, Ethnie, Localite) ; sera reuni avec les autres lots lors de la fusion finale. Cardinalite : 0..*.</rdfs:comment>
        <rdfs:label xml:lang="fr">aPourMedia</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/burkina-environnement#aPourModePreparation -->

    <owl:ObjectProperty rdf:about="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#aPourModePreparation">
        <rdfs:domain rdf:resource="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#UsageMedicinal"/>
        <rdfs:range rdf:resource="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#ModePreparation"/>
        <rdfs:comment xml:lang="fr">Mode de preparation du remede. Cardinalite : 0..*.</rdfs:comment>
        <rdfs:label xml:lang="fr">aPourModePreparation</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/burkina-environnement#aPourParentePlaisanterie -->

    <owl:ObjectProperty rdf:about="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#aPourParentePlaisanterie">
        <owl:inverseOf rdf:resource="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#aPourParentePlaisanterie"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
        <rdfs:domain rdf:resource="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#Ethnie"/>
        <rdfs:range rdf:resource="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#Ethnie"/>
        <rdfs:comment xml:lang="fr">Parente a plaisanterie entre deux ethnies (ex. Mosse-Bissa). Cardinalite : 0..*.</rdfs:comment>
        <rdfs:label xml:lang="fr">aPourParentePlaisanterie</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/burkina-environnement#aPourSource -->

    <owl:ObjectProperty rdf:about="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#aPourSource">
        <owl:inverseOf rdf:resource="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#estSourceDe"/>
        <rdfs:domain rdf:resource="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#CoursEau"/>
        <rdfs:range rdf:resource="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#PointRemarquable"/>
        <rdfs:comment xml:lang="fr">Source connue du cours d&apos;eau. Cardinalite : 0..1.</rdfs:comment>
        <rdfs:label xml:lang="fr">aPourSource</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/burkina-environnement#aPourSousBassin -->

    <owl:ObjectProperty rdf:about="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#aPourSousBassin">
        <owl:inverseOf rdf:resource="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#estSousBassinDe"/>
        <rdfs:domain rdf:resource="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#BassinVersant"/>
        <rdfs:range rdf:resource="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#SousBassin"/>
        <rdfs:comment xml:lang="fr">Composition du bassin versant. Cardinalite : 1..*.</rdfs:comment>
        <rdfs:label xml:lang="fr">aPourSousBassin</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/burkina-environnement#aPourTaxonFils -->

    <owl:ObjectProperty rdf:about="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#aPourTaxonFils">
        <owl:inverseOf rdf:resource="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#aPourTaxonParent"/>
        <rdfs:domain rdf:resource="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#Taxon"/>
        <rdfs:comment xml:lang="fr">Taxon(s) fils direct(s). Range non contraint volontairement : via inverseOf(aPourTaxonParent), un range Taxon retyperait les especes comme Taxon et violerait la disjonction EspeceAnimale/EspeceVegetale vs Taxon des que les sous-proprietes de rattachement sont utilisees.</rdfs:comment>
        <rdfs:label xml:lang="fr">aPourTaxonFils</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/burkina-environnement#aPourTaxonParent -->

    <owl:ObjectProperty rdf:about="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#aPourTaxonParent">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <rdfs:range rdf:resource="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#Taxon"/>
        <rdfs:comment xml:lang="fr">Lien d&apos;un taxon vers son taxon parent, tous domaines du vivant ; les rattachements de rang (flore, faune) en sont des sous-proprietes. Domaine non contraint volontairement : le typage Taxon des especes par inference de domaine contredirait la disjonction entre Taxon et les classes d&apos;especes. Cardinalite : 0..1.</rdfs:comment>
        <rdfs:label xml:lang="fr">aPourTaxonParent</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/burkina-environnement#aPourUsage -->

    <owl:ObjectProperty rdf:about="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#aPourUsage">
        <owl:inverseOf rdf:resource="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#usageDe"/>
        <rdfs:domain rdf:resource="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#EspeceVegetale"/>
        <rdfs:range rdf:resource="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#Usage"/>
        <rdfs:comment xml:lang="fr">Usage(s) associes a l&apos;espece. Cardinalite : 0..*.</rdfs:comment>
        <rdfs:label xml:lang="fr">aPourUsage</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/burkina-environnement#aPourVersement -->

    <owl:ObjectProperty rdf:about="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#aPourVersement">
        <owl:inverseOf rdf:resource="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#estVersementDe"/>
        <rdfs:domain rdf:resource="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#CoursEau"/>
        <rdfs:range rdf:resource="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#PointRemarquable"/>
        <rdfs:comment xml:lang="fr">Point de versement. Cardinalite : 0..1.</rdfs:comment>
        <rdfs:label xml:lang="fr">aPourVersement</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/burkina-environnement#aPourZoneClimatique -->

    <owl:ObjectProperty rdf:about="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#aPourZoneClimatique">
        <rdfs:domain rdf:resource="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#Localite"/>
        <rdfs:range rdf:resource="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#ZoneClimatique"/>
        <rdfs:comment xml:lang="fr">Zone climatique d&apos;une localite. Cardinalite : 0..1.</rdfs:comment>
        <rdfs:label xml:lang="fr">aPourZoneClimatique</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/burkina-environnement#aStatutConservation -->

    <owl:ObjectProperty rdf:about="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#aStatutConservation">
        <owl:inverseOf rdf:resource="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#estStatutDe"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#EspeceAnimale"/>
        <rdfs:range rdf:resource="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#StatutConservation"/>
        <rdfs:comment xml:lang="fr">Statut de conservation UICN de l&apos;espece. Cardinalite : 1..1.</rdfs:comment>
        <rdfs:label xml:lang="fr">aStatutConservation</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/burkina-environnement#abrite -->

    <owl:ObjectProperty rdf:about="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#abrite">
        <owl:inverseOf rdf:resource="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#estPresenteDans"/>
        <rdfs:domain rdf:resource="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#Localite"/>
        <rdfs:range rdf:resource="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#EspeceVegetale"/>
        <rdfs:comment xml:lang="fr">Espece(s) vegetale(s) presente(s) dans cette localite.</rdfs:comment>
        <rdfs:label xml:lang="fr">abrite</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/burkina-environnement#abriteEthnie -->

    <owl:ObjectProperty rdf:about="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#abriteEthnie">
        <owl:inverseOf rdf:resource="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#habite"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#AireGeographique"/>
                    <rdf:Description rdf:about="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#Localite"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#Ethnie"/>
        <rdfs:comment xml:lang="fr">Ethnies principalement presentes dans cette localite.</rdfs:comment>
        <rdfs:label xml:lang="fr">abriteEthnie</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/burkina-environnement#affluentDe -->

    <owl:ObjectProperty rdf:about="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#affluentDe">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <rdfs:domain rdf:resource="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#CoursEau"/>
        <rdfs:range rdf:resource="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#CoursEau"/>
        <rdfs:comment xml:lang="fr">Relation entre affluent et cours d&apos;eau recepteur. Cardinalite : 0..1.</rdfs:comment>
        <rdfs:label xml:lang="fr">affluentDe</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/burkina-environnement#appartientAClasseBotanique -->

    <owl:ObjectProperty rdf:about="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#appartientAClasseBotanique">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#Ordre"/>
        <rdfs:range rdf:resource="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#ClasseBotanique"/>
        <rdfs:subPropertyOf rdf:resource="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#aPourTaxonParent"/>
        <rdfs:comment xml:lang="fr">Classe botanique parente (sous-propriete de aPourTaxonParent). Cardinalite : 1..1.</rdfs:comment>
        <rdfs:label xml:lang="fr">appartientAClasseBotanique</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/burkina-environnement#appartientAEmbranchement -->

    <owl:ObjectProperty rdf:about="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#appartientAEmbranchement">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#ClasseBotanique"/>
        <rdfs:range rdf:resource="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#Embranchement"/>
        <rdfs:subPropertyOf rdf:resource="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#aPourTaxonParent"/>
        <rdfs:comment xml:lang="fr">Embranchement parent (sous-propriete de aPourTaxonParent). Cardinalite : 1..1.</rdfs:comment>
        <rdfs:label xml:lang="fr">appartientAEmbranchement</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/burkina-environnement#appartientAFamilleBotanique -->

    <owl:ObjectProperty rdf:about="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#appartientAFamilleBotanique">
        <owl:inverseOf rdf:resource="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#regroupeEspeceVegetale"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#EspeceVegetale"/>
        <rdfs:range rdf:resource="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#FamilleBotanique"/>
        <rdfs:subPropertyOf rdf:resource="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#aPourTaxonParent"/>
        <rdfs:comment xml:lang="fr">Famille botanique de l&apos;espece (sous-propriete de aPourTaxonParent). Cardinalite : 1..1.</rdfs:comment>
        <rdfs:label xml:lang="fr">appartientAFamilleBotanique</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/burkina-environnement#appartientAFamilleZoologique -->

    <owl:ObjectProperty rdf:about="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#appartientAFamilleZoologique">
        <owl:inverseOf rdf:resource="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#regroupeEspeceAnimale"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#EspeceAnimale"/>
        <rdfs:range rdf:resource="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#FamilleZoologique"/>
        <rdfs:subPropertyOf rdf:resource="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#aPourTaxonParent"/>
        <rdfs:comment xml:lang="fr">Famille zoologique de l&apos;espece (sous-propriete de aPourTaxonParent). Cardinalite : 1..1.</rdfs:comment>
        <rdfs:label xml:lang="fr">appartientAFamilleZoologique</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/burkina-environnement#appartientAOrdre -->

    <owl:ObjectProperty rdf:about="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#appartientAOrdre">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#FamilleBotanique"/>
        <rdfs:range rdf:resource="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#Ordre"/>
        <rdfs:subPropertyOf rdf:resource="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#aPourTaxonParent"/>
        <rdfs:comment xml:lang="fr">Ordre parent (sous-propriete de aPourTaxonParent). Cardinalite : 1..1.</rdfs:comment>
        <rdfs:label xml:lang="fr">appartientAOrdre</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/burkina-environnement#appartientARegne -->

    <owl:ObjectProperty rdf:about="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#appartientARegne">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#Embranchement"/>
        <rdfs:range rdf:resource="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#Regne"/>
        <rdfs:subPropertyOf rdf:resource="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#aPourTaxonParent"/>
        <rdfs:comment xml:lang="fr">Regne parent (sous-propriete de aPourTaxonParent). Cardinalite : 1..1.</rdfs:comment>
        <rdfs:label xml:lang="fr">appartientARegne</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/burkina-environnement#appartientAZoneClimatique -->

    <owl:ObjectProperty rdf:about="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#appartientAZoneClimatique">
        <rdfs:domain rdf:resource="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#EspeceVegetale"/>
        <rdfs:range rdf:resource="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#ZoneClimatique"/>
        <rdfs:comment xml:lang="fr">Zone climatique a laquelle l&apos;espece est adaptee. Cardinalite : 0..*.</rdfs:comment>
        <rdfs:label xml:lang="fr">appartientAZoneClimatique</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/burkina-environnement#appartientAuBassin -->

    <owl:ObjectProperty rdf:about="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#appartientAuBassin">
        <rdfs:domain rdf:resource="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#CoursEau"/>
        <rdfs:range rdf:resource="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#BassinVersant"/>
        <rdfs:comment xml:lang="fr">Bassin versant du cours d&apos;eau - propriete inferee (regle R-E1). Cardinalite : 0..1.</rdfs:comment>
        <rdfs:label xml:lang="fr">appartientAuBassin</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/burkina-environnement#contient -->

    <owl:ObjectProperty rdf:about="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#contient">
        <owl:inverseOf rdf:resource="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#estSitueeDans"/>
        <rdfs:domain rdf:resource="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#Localite"/>
        <rdfs:range rdf:resource="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#Localite"/>
        <rdfs:comment xml:lang="fr">Localites filles directes.</rdfs:comment>
        <rdfs:label xml:lang="fr">contient</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/burkina-environnement#disposeDeRemedeContre -->

    <owl:ObjectProperty rdf:about="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#disposeDeRemedeContre">
        <rdfs:domain rdf:resource="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#Localite"/>
        <rdfs:range rdf:resource="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#Pathologie"/>
        <rdfs:comment xml:lang="fr">Potentiel therapeutique d&apos;une localite - propriete inferee (regle R-F4). Cardinalite : 0..*.</rdfs:comment>
        <rdfs:label xml:lang="fr">disposeDeRemedeContre</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/burkina-environnement#estAppellationDe -->

    <owl:ObjectProperty rdf:about="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#estAppellationDe">
        <rdfs:domain rdf:resource="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#Appellation"/>
        <rdfs:range rdf:resource="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#CoursEau"/>
        <rdfs:comment xml:lang="fr">Cours d&apos;eau designe par cette appellation.</rdfs:comment>
        <rdfs:label xml:lang="fr">estAppellationDe</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/burkina-environnement#estCaracteristiqueDe -->

    <owl:ObjectProperty rdf:about="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#estCaracteristiqueDe">
        <rdfs:domain rdf:resource="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#CaracteristiqueHydrologique"/>
        <rdfs:range rdf:resource="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#CoursEau"/>
        <rdfs:comment xml:lang="fr">Cours d&apos;eau mesure.</rdfs:comment>
        <rdfs:label xml:lang="fr">estCaracteristiqueDe</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/burkina-environnement#estDansRegion -->

    <owl:ObjectProperty rdf:about="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#estDansRegion">
        <rdfs:domain rdf:resource="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#Localite"/>
        <rdfs:range rdf:resource="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#Region"/>
        <rdfs:comment xml:lang="fr">Region rattachee a une localite, deduite par la regle R-N3 a partir de la province. Propriete inferee, jamais saisie directement.</rdfs:comment>
        <rdfs:label xml:lang="fr">estDansRegion</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/burkina-environnement#estEthnieDe -->

    <owl:ObjectProperty rdf:about="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#estEthnieDe">
        <rdfs:domain rdf:resource="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#Ethnie"/>
        <rdfs:range rdf:resource="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#CoursEau"/>
        <rdfs:comment xml:lang="fr">Cours d&apos;eau associe(s) a cette ethnie riveraine.</rdfs:comment>
        <rdfs:label xml:lang="fr">estEthnieDe</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/burkina-environnement#estMediaDe -->

    <owl:ObjectProperty rdf:about="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#estMediaDe">
        <rdfs:domain rdf:resource="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#Media"/>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#CoursEau"/>
                    <rdf:Description rdf:about="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#EspeceAnimale"/>
                    <rdf:Description rdf:about="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#EspeceVegetale"/>
                    <rdf:Description rdf:about="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#Ethnie"/>
                    <rdf:Description rdf:about="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#Localite"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
        <rdfs:comment xml:lang="fr">Element illustre par ce media (domaine restreint au lot Environnement).</rdfs:comment>
        <rdfs:label xml:lang="fr">estMediaDe</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/burkina-environnement#estMilieuDe -->

    <owl:ObjectProperty rdf:about="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#estMilieuDe">
        <owl:inverseOf rdf:resource="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#vitDans"/>
        <rdfs:domain rdf:resource="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#MilieuDeVie"/>
        <rdfs:range rdf:resource="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#EspeceAnimale"/>
        <rdfs:comment xml:lang="fr">Espece(s) vivant dans ce milieu.</rdfs:comment>
        <rdfs:label xml:lang="fr">estMilieuDe</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/burkina-environnement#estObserveeDans -->

    <owl:ObjectProperty rdf:about="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#estObserveeDans">
        <owl:inverseOf rdf:resource="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#heberge"/>
        <rdfs:domain rdf:resource="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#EspeceAnimale"/>
        <rdfs:range rdf:resource="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#Localite"/>
        <rdfs:comment xml:lang="fr">Localites (parcs, reserves) ou l&apos;espece a ete observee. Cardinalite : 1..*.</rdfs:comment>
        <rdfs:label xml:lang="fr">estObserveeDans</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/burkina-environnement#estPresenteDans -->

    <owl:ObjectProperty rdf:about="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#estPresenteDans">
        <rdfs:domain rdf:resource="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#EspeceVegetale"/>
        <rdfs:range rdf:resource="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#Localite"/>
        <rdfs:comment xml:lang="fr">Localites ou l&apos;espece est recensee. Cardinalite : 0..*.</rdfs:comment>
        <rdfs:label xml:lang="fr">estPresenteDans</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/burkina-environnement#estRattacheA -->

    <owl:ObjectProperty rdf:about="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#estRattacheA">
        <owl:inverseOf rdf:resource="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#regroupeCoursEau"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#CoursEau"/>
        <rdfs:range rdf:resource="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#SousBassin"/>
        <rdfs:comment xml:lang="fr">Rattachement d&apos;un cours d&apos;eau a son sous-bassin. Cardinalite : 1..1.</rdfs:comment>
        <rdfs:label xml:lang="fr">estRattacheA</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/burkina-environnement#estSitueeDans -->

    <owl:ObjectProperty rdf:about="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#estSitueeDans">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <rdfs:domain rdf:resource="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#Localite"/>
        <rdfs:range rdf:resource="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#Localite"/>
        <rdfs:comment xml:lang="fr">Rattachement hierarchique d&apos;une localite a son entite parente (village -&gt; commune -&gt; departement -&gt; province -&gt; region -&gt; pays ; quartier -&gt; secteur -&gt; arrondissement -&gt; commune urbaine). Cardinalite : 0..1.</rdfs:comment>
        <rdfs:label xml:lang="fr">estSitueeDans</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/burkina-environnement#estSoigneePar -->

    <owl:ObjectProperty rdf:about="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#estSoigneePar">
        <owl:inverseOf rdf:resource="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#soigne"/>
        <rdfs:domain rdf:resource="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#Pathologie"/>
        <rdfs:range rdf:resource="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#UsageMedicinal"/>
        <rdfs:comment xml:lang="fr">Usage(s) soignant cette pathologie.</rdfs:comment>
        <rdfs:label xml:lang="fr">estSoigneePar</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/burkina-environnement#estSourceDe -->

    <owl:ObjectProperty rdf:about="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#estSourceDe">
        <rdfs:domain rdf:resource="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#PointRemarquable"/>
        <rdfs:range rdf:resource="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#CoursEau"/>
        <rdfs:comment xml:lang="fr">Cours d&apos;eau ayant cette source.</rdfs:comment>
        <rdfs:label xml:lang="fr">estSourceDe</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/burkina-environnement#estSousBassinDe -->

    <owl:ObjectProperty rdf:about="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#estSousBassinDe">
        <rdfs:domain rdf:resource="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#SousBassin"/>
        <rdfs:range rdf:resource="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#BassinVersant"/>
        <rdfs:comment xml:lang="fr">Bassin versant englobant.</rdfs:comment>
        <rdfs:label xml:lang="fr">estSousBassinDe</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/burkina-environnement#estStatutDe -->

    <owl:ObjectProperty rdf:about="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#estStatutDe">
        <rdfs:domain rdf:resource="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#StatutConservation"/>
        <rdfs:range rdf:resource="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#EspeceAnimale"/>
        <rdfs:comment xml:lang="fr">Espece(s) ayant ce statut.</rdfs:comment>
        <rdfs:label xml:lang="fr">estStatutDe</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/burkina-environnement#estTraverseePar -->

    <owl:ObjectProperty rdf:about="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#estTraverseePar">
        <owl:inverseOf rdf:resource="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#traverse"/>
        <rdfs:domain rdf:resource="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#Localite"/>
        <rdfs:range rdf:resource="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#CoursEau"/>
        <rdfs:comment xml:lang="fr">Cours d&apos;eau traversant cette localite.</rdfs:comment>
        <rdfs:label xml:lang="fr">estTraverseePar</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/burkina-environnement#estVersementDe -->

    <owl:ObjectProperty rdf:about="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#estVersementDe">
        <rdfs:domain rdf:resource="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#PointRemarquable"/>
        <rdfs:range rdf:resource="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#CoursEau"/>
        <rdfs:comment xml:lang="fr">Cours d&apos;eau ayant ce point de versement.</rdfs:comment>
        <rdfs:label xml:lang="fr">estVersementDe</rdfs:label>
    </owl:ObjectProperty>
    



    


    <!-- http://www.ibam-ujkz.bf/ontologies/burkina-environnement#habite -->

    <owl:ObjectProperty rdf:about="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#habite">
        <rdfs:domain rdf:resource="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#Ethnie"/>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#AireGeographique"/>
                    <rdf:Description rdf:about="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#Localite"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
        <rdfs:comment xml:lang="fr">Localites ou une ethnie est principalement presente (synonyme : estImplanteeDans). Cardinalite : 1..*.</rdfs:comment>
        <rdfs:label xml:lang="fr">habite</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/burkina-environnement#heberge -->

    <owl:ObjectProperty rdf:about="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#heberge">
        <rdfs:domain rdf:resource="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#Localite"/>
        <rdfs:range rdf:resource="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#EspeceAnimale"/>
        <rdfs:comment xml:lang="fr">Espece(s) observee(s) dans cette localite.</rdfs:comment>
        <rdfs:label xml:lang="fr">heberge</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/burkina-environnement#localiseeSur -->

    <owl:ObjectProperty rdf:about="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#localiseeSur">
        <owl:inverseOf rdf:resource="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#represente"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#Localite"/>
        <rdfs:range rdf:resource="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#CarteSpatiale"/>
        <rdfs:comment xml:lang="fr">Associe une localite a sa position sur une carte. Cardinalite : 1..1.</rdfs:comment>
        <rdfs:label xml:lang="fr">localiseeSur</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/burkina-environnement#regroupeCoursEau -->

    <owl:ObjectProperty rdf:about="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#regroupeCoursEau">
        <rdfs:domain rdf:resource="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#SousBassin"/>
        <rdfs:range rdf:resource="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#CoursEau"/>
        <rdfs:comment xml:lang="fr">Cours d&apos;eau rattache(s) a ce sous-bassin.</rdfs:comment>
        <rdfs:label xml:lang="fr">regroupeCoursEau</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/burkina-environnement#regroupeEspeceAnimale -->

    <owl:ObjectProperty rdf:about="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#regroupeEspeceAnimale">
        <rdfs:domain rdf:resource="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#FamilleZoologique"/>
        <rdfs:range rdf:resource="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#EspeceAnimale"/>
        <rdfs:comment xml:lang="fr">Espece(s) de cette famille zoologique.</rdfs:comment>
        <rdfs:label xml:lang="fr">regroupeEspeceAnimale</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/burkina-environnement#regroupeEspeceVegetale -->

    <owl:ObjectProperty rdf:about="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#regroupeEspeceVegetale">
        <rdfs:domain rdf:resource="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#FamilleBotanique"/>
        <rdfs:range rdf:resource="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#EspeceVegetale"/>
        <rdfs:comment xml:lang="fr">Espece(s) de cette famille botanique.</rdfs:comment>
        <rdfs:label xml:lang="fr">regroupeEspeceVegetale</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/burkina-environnement#represente -->


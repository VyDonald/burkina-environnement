        <rdfs:comment xml:lang="fr">Localite representee par cette carte.</rdfs:comment>
        <rdfs:label xml:lang="fr">represente</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/burkina-environnement#soigne -->


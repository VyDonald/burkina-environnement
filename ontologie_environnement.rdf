        <rdfs:label xml:lang="fr">appellationLocale</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/burkina-environnement#chefLieu -->

    <owl:DatatypeProperty rdf:about="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#chefLieu">

        <rdfs:range rdf:resource="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#Localite"/>
        <rdfs:comment xml:lang="fr">Localites traversees ou bordees. Cardinalite : 0..*.</rdfs:comment>
        <rdfs:label xml:lang="fr">traverse</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/burkina-environnement#usageDe -->

    <owl:ObjectProperty rdf:about="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#usageDe">

    <swrl:Imp rdf:about="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#regle_RE1">
        <rdfs:comment xml:lang="fr">Ordre botanique remonte comme parent taxonomique de la famille.</rdfs:comment>
        <swrl:body rdf:parseType="Collection">
            <swrl:IndividualPropertyAtom>
                <swrl:propertyPredicate rdf:resource="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#appartientAOrdre"/>
                <swrl:argument1 rdf:resource="urn:swrl:var#f"/>
                <swrl:argument2 rdf:resource="urn:swrl:var#o"/>
            </swrl:IndividualPropertyAtom>
        </swrl:body>
        <swrl:head rdf:parseType="Collection">
            <swrl:IndividualPropertyAtom>
                <swrl:propertyPredicate rdf:resource="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#aPourTaxonParent"/>
                <swrl:argument1 rdf:resource="urn:swrl:var#f"/>
                <swrl:argument2 rdf:resource="urn:swrl:var#o"/>
            </swrl:IndividualPropertyAtom>
        </swrl:head>
    </swrl:Imp>
    <swrl:Imp rdf:about="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#regle_RF1">
        <rdfs:comment xml:lang="fr">Classe botanique remontee comme parent taxonomique de l&apos;ordre.</rdfs:comment>
        <swrl:body rdf:parseType="Collection">
            <swrl:IndividualPropertyAtom>
                <swrl:propertyPredicate rdf:resource="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#appartientAClasseBotanique"/>
                <swrl:argument1 rdf:resource="urn:swrl:var#o"/>
                <swrl:argument2 rdf:resource="urn:swrl:var#c"/>
            </swrl:IndividualPropertyAtom>
        </swrl:body>
        <swrl:head rdf:parseType="Collection">
            <swrl:IndividualPropertyAtom>
                <swrl:propertyPredicate rdf:resource="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#aPourTaxonParent"/>
                <swrl:argument1 rdf:resource="urn:swrl:var#o"/>
                <swrl:argument2 rdf:resource="urn:swrl:var#c"/>
            </swrl:IndividualPropertyAtom>
        </swrl:head>
    </swrl:Imp>
    <swrl:Imp rdf:about="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#regle_RF2">
        <rdfs:comment xml:lang="fr">Embranchement remonte comme parent taxonomique de la classe botanique.</rdfs:comment>
        <swrl:body rdf:parseType="Collection">
            <swrl:IndividualPropertyAtom>
                <swrl:propertyPredicate rdf:resource="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#appartientAEmbranchement"/>
                <swrl:argument1 rdf:resource="urn:swrl:var#c"/>
                <swrl:argument2 rdf:resource="urn:swrl:var#em"/>
            </swrl:IndividualPropertyAtom>
        </swrl:body>
        <swrl:head rdf:parseType="Collection">
            <swrl:IndividualPropertyAtom>
                <swrl:propertyPredicate rdf:resource="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#aPourTaxonParent"/>
                <swrl:argument1 rdf:resource="urn:swrl:var#c"/>
                <swrl:argument2 rdf:resource="urn:swrl:var#em"/>
            </swrl:IndividualPropertyAtom>
        </swrl:head>
    </swrl:Imp>
    <swrl:Imp rdf:about="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#regle_RF3">
        <rdfs:comment xml:lang="fr">Regne remonte comme parent taxonomique de l&apos;embranchement.</rdfs:comment>
        <swrl:body rdf:parseType="Collection">
            <swrl:IndividualPropertyAtom>
                <swrl:propertyPredicate rdf:resource="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#appartientARegne"/>
                <swrl:argument1 rdf:resource="urn:swrl:var#em"/>
                <swrl:argument2 rdf:resource="urn:swrl:var#r"/>
            </swrl:IndividualPropertyAtom>
        </swrl:body>
        <swrl:head rdf:parseType="Collection">
            <swrl:IndividualPropertyAtom>
                <swrl:propertyPredicate rdf:resource="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#aPourTaxonParent"/>
                <swrl:argument1 rdf:resource="urn:swrl:var#em"/>
                <swrl:argument2 rdf:resource="urn:swrl:var#r"/>
            </swrl:IndividualPropertyAtom>
        </swrl:head>
    </swrl:Imp>
    <swrl:Imp rdf:about="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#regle_RF4">
        <rdfs:comment xml:lang="fr">Zone climatique deduite de la localite d&apos;observation de l&apos;espece vegetale.</rdfs:comment>
        <swrl:body rdf:parseType="Collection">
            <swrl:ClassAtom>
                <swrl:classPredicate rdf:resource="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#EspeceVegetale"/>
                <swrl:argument1 rdf:resource="urn:swrl:var#s"/>
            </swrl:ClassAtom>
            <swrl:IndividualPropertyAtom>
                <swrl:propertyPredicate rdf:resource="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#estPresenteDans"/>
                <swrl:argument1 rdf:resource="urn:swrl:var#s"/>
                <swrl:argument2 rdf:resource="urn:swrl:var#l"/>
            </swrl:IndividualPropertyAtom>
            <swrl:IndividualPropertyAtom>
                <swrl:propertyPredicate rdf:resource="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#aPourZoneClimatique"/>
                <swrl:argument1 rdf:resource="urn:swrl:var#l"/>
                <swrl:argument2 rdf:resource="urn:swrl:var#z2"/>
            </swrl:IndividualPropertyAtom>
        </swrl:body>
        <swrl:head rdf:parseType="Collection">
            <swrl:IndividualPropertyAtom>
                <swrl:propertyPredicate rdf:resource="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#appartientAZoneClimatique"/>
                <swrl:argument1 rdf:resource="urn:swrl:var#s"/>
                <swrl:argument2 rdf:resource="urn:swrl:var#z2"/>
            </swrl:IndividualPropertyAtom>
        </swrl:head>
    </swrl:Imp>
    <swrl:Imp rdf:about="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#regle_RF5">
        <rdfs:comment xml:lang="fr">Cours d&apos;eau rattache au bassin versant via son sous-bassin.</rdfs:comment>
        <swrl:body rdf:parseType="Collection">
            <swrl:IndividualPropertyAtom>
                <swrl:propertyPredicate rdf:resource="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#aPourSousBassin"/>
                <swrl:argument1 rdf:resource="urn:swrl:var#b"/>
                <swrl:argument2 rdf:resource="urn:swrl:var#sb"/>
            </swrl:IndividualPropertyAtom>
            <swrl:IndividualPropertyAtom>
                <swrl:propertyPredicate rdf:resource="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#regroupeCoursEau"/>
                <swrl:argument1 rdf:resource="urn:swrl:var#sb"/>
                <swrl:argument2 rdf:resource="urn:swrl:var#c2"/>
            </swrl:IndividualPropertyAtom>
        </swrl:body>
        <swrl:head rdf:parseType="Collection">
            <swrl:IndividualPropertyAtom>
                <swrl:propertyPredicate rdf:resource="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#aPourCoursEau"/>
                <swrl:argument1 rdf:resource="urn:swrl:var#b"/>
                <swrl:argument2 rdf:resource="urn:swrl:var#c2"/>
            </swrl:IndividualPropertyAtom>
        </swrl:head>
    </swrl:Imp>
    <swrl:Imp rdf:about="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#regle_RN3">
        <rdfs:comment xml:lang="fr">Un cours d&apos;eau traversant une entite administrative la traverse aussi dans ses entites contenues.</rdfs:comment>
        <swrl:body rdf:parseType="Collection">
            <swrl:IndividualPropertyAtom>
                <swrl:propertyPredicate rdf:resource="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#traverse"/>
                <swrl:argument1 rdf:resource="urn:swrl:var#x"/>
                <swrl:argument2 rdf:resource="urn:swrl:var#l"/>
            </swrl:IndividualPropertyAtom>
            <swrl:IndividualPropertyAtom>
                <swrl:propertyPredicate rdf:resource="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#contient"/>
                <swrl:argument1 rdf:resource="urn:swrl:var#l"/>
                <swrl:argument2 rdf:resource="urn:swrl:var#z"/>
            </swrl:IndividualPropertyAtom>
        </swrl:body>
        <swrl:head rdf:parseType="Collection">
            <swrl:IndividualPropertyAtom>
                <swrl:propertyPredicate rdf:resource="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#traverse"/>
                <swrl:argument1 rdf:resource="urn:swrl:var#x"/>
                <swrl:argument2 rdf:resource="urn:swrl:var#z"/>
            </swrl:IndividualPropertyAtom>
        </swrl:head>
    </swrl:Imp>
    



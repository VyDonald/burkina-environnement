        <rdfs:range rdf:resource="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#Pathologie"/>
        <rdfs:comment xml:lang="fr">Raccourci espece -&gt; pathologie - propriete inferee (regle R-F1). Cardinalite : 0..*.</rdfs:comment>
        <rdfs:label xml:lang="fr">soignePathologie</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/burkina-environnement#traverse -->


        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:comment xml:lang="fr">Date ou periode de l&apos;observation.</rdfs:comment>
        <rdfs:label xml:lang="fr">dateObservation</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/burkina-environnement#debitMoyen -->

    <owl:DatatypeProperty rdf:about="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#debitMoyen">
        <rdfs:domain rdf:resource="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#CaracteristiqueHydrologique"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment xml:lang="fr">Debit moyen en m3/s.</rdfs:comment>
        <rdfs:label xml:lang="fr">debitMoyen</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/burkina-environnement#description -->

    <owl:DatatypeProperty rdf:about="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#description">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#EspeceAnimale"/>
                    <rdf:Description rdf:about="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#EspeceVegetale"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="fr">Description generale. Applicable a EspeceVegetale, EspeceAnimale et autres ressources.</rdfs:comment>
        <rdfs:label xml:lang="fr">description</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/burkina-environnement#dureeVideo -->

    <owl:DatatypeProperty rdf:about="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#dureeVideo">

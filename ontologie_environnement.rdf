    <!-- http://www.ibam-ujkz.bf/ontologies/burkina-environnement#AireGeographique -->

    <owl:Class rdf:about="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#AireGeographique">
        <rdfs:comment xml:lang="fr">Emprise geographique reelle d&apos;une communaute, d&apos;une langue ou d&apos;un phenomene, distincte des limites administratives. Synonyme : Zone d&apos;implantation.</rdfs:comment>
        <rdfs:label xml:lang="fr">AireGeographique</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/burkina-environnement#Appellation -->

    <owl:Class rdf:about="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#Appellation">
        <rdfs:comment xml:lang="fr">Nom officiel, nom local ou appellation alternative d&apos;un cours d&apos;eau (ex. Volta Noire pour le Mouhoun). Synonyme : Nom local.</rdfs:comment>
        <rdfs:label xml:lang="fr">Appellation</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/burkina-environnement#Arrondissement -->

    <owl:Class rdf:about="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#Arrondissement">
        <rdfs:subClassOf rdf:resource="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#Localite"/>
        <rdfs:comment xml:lang="fr">Subdivision des communes urbaines a statut particulier ; regroupe des secteurs. Synonyme : Subdivision communale.</rdfs:comment>
        <rdfs:label xml:lang="fr">Arrondissement</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/burkina-environnement#BassinVersant -->

    <owl:Class rdf:about="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#BassinVersant">
        <rdfs:subClassOf rdf:resource="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#UniteHydrographique"/>
        <rdfs:comment xml:lang="fr">Grand bassin (Volta, Niger, Comoe). Synonyme : Groupe.</rdfs:comment>
        <rdfs:label xml:lang="fr">BassinVersant</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/burkina-environnement#CaracteristiqueHydrologique -->

    <owl:Class rdf:about="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#CaracteristiqueHydrologique">
        <rdfs:comment xml:lang="fr">Debit moyen, hauteur d&apos;eau, periode de crue ou autre caracteristique mesuree, datee et sourcee. Synonyme : Mesure.</rdfs:comment>
        <rdfs:label xml:lang="fr">CaracteristiqueHydrologique</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/burkina-environnement#CarteSpatiale -->

    <owl:Class rdf:about="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#CarteSpatiale">
        <rdfs:comment xml:lang="fr">Representation permettant de localiser les elements de l&apos;ontologie sur le territoire (echelle, projection). Synonymes : Carte geographique, Geolocalisation.</rdfs:comment>
        <rdfs:label xml:lang="fr">CarteSpatiale</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/burkina-environnement#ClasseBotanique -->

    <owl:Class rdf:about="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#ClasseBotanique">
        <rdfs:subClassOf rdf:resource="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#Taxon"/>
        <rdfs:comment xml:lang="fr">Niveau botanique correspondant au terme usuel de « sous-groupe » (ex. Dicotyledones).</rdfs:comment>
        <rdfs:label xml:lang="fr">ClasseBotanique</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/burkina-environnement#Commune -->

    <owl:Class rdf:about="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#Commune">
        <rdfs:subClassOf rdf:resource="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#Localite"/>
        <rdfs:comment xml:lang="fr">Collectivite territoriale rattachee a un departement ; urbaine ou rurale. Synonymes : Circonscription territoriale, Municipalite.</rdfs:comment>
        <rdfs:label xml:lang="fr">Commune</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/burkina-environnement#CommuneRurale -->

    <owl:Class rdf:about="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#CommuneRurale">
        <rdfs:subClassOf rdf:resource="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#Commune"/>
        <rdfs:comment xml:lang="fr">Regroupe des villages. Synonyme : Municipalite rurale.</rdfs:comment>
        <rdfs:label xml:lang="fr">CommuneRurale</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/burkina-environnement#CommuneUrbaine -->

    <owl:Class rdf:about="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#CommuneUrbaine">
        <rdfs:subClassOf rdf:resource="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#Commune"/>
        <rdfs:comment xml:lang="fr">Agglomeration d&apos;au moins 10 000 habitants ; subdivisee en arrondissements (Ouagadougou, Bobo-Dioulasso). Synonyme : Municipalite urbaine.</rdfs:comment>
        <rdfs:label xml:lang="fr">CommuneUrbaine</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/burkina-environnement#CoursEau -->

    <owl:Class rdf:about="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#CoursEau">
        <rdfs:comment xml:lang="fr">Classe racine des entites hydrographiques : ecoulement d&apos;eaux courantes dans un lit naturel, alimente par une source. Les eaux stagnantes (lacs, mares, barrages) sont hors perimetre.</rdfs:comment>
        <rdfs:label xml:lang="fr">CoursEau</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/burkina-environnement#Departement -->

    <owl:Class rdf:about="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#Departement">
        <rdfs:subClassOf rdf:resource="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#Localite"/>
        <rdfs:comment xml:lang="fr">Circonscription de base de l&apos;Etat (350), placee sous l&apos;autorite d&apos;un prefet ; appartient a une province. Synonyme : Circonscription departementale.</rdfs:comment>
        <rdfs:label xml:lang="fr">Departement</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/burkina-environnement#Embranchement -->

    <owl:Class rdf:about="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#Embranchement">
        <rdfs:subClassOf rdf:resource="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#Taxon"/>
        <rdfs:comment xml:lang="fr">Niveau botanique correspondant au terme usuel de « groupe » (ex. Angiospermes).</rdfs:comment>
        <rdfs:label xml:lang="fr">Embranchement</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/burkina-environnement#EspeceAnimale -->

    <owl:Class rdf:about="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#EspeceAnimale">
        <owl:hasKey rdf:parseType="Collection">
            <rdf:Description rdf:about="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#nomScientifique"/>
        </owl:hasKey>
        <rdfs:comment xml:lang="fr">Espece animale observee au Burkina Faso, identifiee par son nom scientifique ; classe centrale de ce theme.</rdfs:comment>
        <rdfs:label xml:lang="fr">EspeceAnimale</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/burkina-environnement#EspeceMultiUsage -->

    <owl:Class rdf:about="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#EspeceMultiUsage">
        <rdfs:subClassOf rdf:resource="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#EspeceVegetale"/>
        <rdfs:comment xml:lang="fr">Espece vegetale a la fois alimentaire et medicinale. Classe inferee par la regle SWRL R-F3.</rdfs:comment>
        <rdfs:label xml:lang="fr">EspeceMultiUsage</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/burkina-environnement#EspeceStrategiqueSecuriteAlimentaire -->

    <owl:Class rdf:about="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#EspeceStrategiqueSecuriteAlimentaire">
        <rdfs:subClassOf rdf:resource="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#EspeceVegetale"/>
        <rdfs:comment xml:lang="fr">Espece alimentaire adaptee a la zone sahelienne. Classe inferee par la regle SWRL R-F5.</rdfs:comment>
        <rdfs:label xml:lang="fr">EspeceStrategiqueSecuriteAlimentaire</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/burkina-environnement#EspeceVegetale -->

    <owl:Class rdf:about="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#EspeceVegetale">
        <owl:hasKey rdf:parseType="Collection">
            <rdf:Description rdf:about="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#nomScientifique"/>
        </owl:hasKey>
        <rdfs:comment xml:lang="fr">Espece vegetale recensee au Burkina Faso, identifiee par son nom scientifique binomial ; classe centrale de ce theme.</rdfs:comment>
        <rdfs:label xml:lang="fr">EspeceVegetale</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/burkina-environnement#Ethnie -->

    <owl:Class rdf:about="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#Ethnie">
        <rdfs:comment xml:lang="fr">Groupe de personnes partageant une meme culture, une langue et des traditions (culinaires, musicales...). Concept pivot de la fusion. Synonymes : GroupeEthnique, Peuple, Communaute.</rdfs:comment>
        <rdfs:label xml:lang="fr">Ethnie</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/burkina-environnement#FamilleBotanique -->

    <owl:Class rdf:about="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#FamilleBotanique">
        <rdfs:subClassOf rdf:resource="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#Taxon"/>
        <rdfs:comment xml:lang="fr">Famille rattachee a un ordre (ex. Sapotaceae, Fabaceae). Synonyme : Famille.</rdfs:comment>
        <rdfs:label xml:lang="fr">FamilleBotanique</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/burkina-environnement#FamilleZoologique -->

    <owl:Class rdf:about="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#FamilleZoologique">
        <rdfs:subClassOf rdf:resource="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#Taxon"/>
        <rdfs:comment xml:lang="fr">Niveau le plus fin (ex. Felides, Elephantides). Synonyme : Famille.</rdfs:comment>
        <rdfs:label xml:lang="fr">FamilleZoologique</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/burkina-environnement#Fleuve -->

    <owl:Class rdf:about="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#Fleuve">
        <rdfs:subClassOf rdf:resource="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#CoursEau"/>
        <rdfs:comment xml:lang="fr">Ex. Mouhoun, Nakanbe, Nazinon.</rdfs:comment>
        <rdfs:label xml:lang="fr">Fleuve</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/burkina-environnement#GroupeZoologique -->

    <owl:Class rdf:about="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#GroupeZoologique">
        <rdfs:subClassOf rdf:resource="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#Taxon"/>
        <rdfs:comment xml:lang="fr">Niveau superieur de la classification zoologique (ex. Mammiferes). Synonyme : Groupe.</rdfs:comment>
        <rdfs:label xml:lang="fr">GroupeZoologique</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/burkina-environnement#Localite -->

    <owl:Class rdf:about="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#Localite">
        <rdfs:comment xml:lang="fr">Classe racine de toute subdivision du territoire ; regroupe les caracteristiques communes (nom, code, population, superficie, coordonnees). Lieu ou un element du patrimoine est situe, prepare, parle, joue, observe ou recense.</rdfs:comment>
        <rdfs:label xml:lang="fr">Localite</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/burkina-environnement#Marigot -->

    <owl:Class rdf:about="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#Marigot">
        <rdfs:subClassOf rdf:resource="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#CoursEau"/>
        <rdfs:comment xml:lang="fr">Ecoulement local, souvent saisonnier.</rdfs:comment>
        <rdfs:label xml:lang="fr">Marigot</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/burkina-environnement#Media -->

    <owl:Class rdf:about="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#Media">
        <rdfs:comment xml:lang="fr">Representation visuelle ou audiovisuelle illustrant un element de l&apos;ontologie.</rdfs:comment>
        <rdfs:label xml:lang="fr">Media</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/burkina-environnement#MilieuDeVie -->

    <owl:Class rdf:about="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#MilieuDeVie">
        <rdfs:comment xml:lang="fr">Type d&apos;environnement dans lequel evolue une espece : aerien, aquatique, terrestre. Synonyme : Milieu.</rdfs:comment>
        <rdfs:label xml:lang="fr">MilieuDeVie</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/burkina-environnement#ModePreparation -->

    <owl:Class rdf:about="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#ModePreparation">
        <rdfs:comment xml:lang="fr">Decoction, infusion, maceration, poudre, cataplasme.</rdfs:comment>
        <rdfs:label xml:lang="fr">ModePreparation</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/burkina-environnement#Ordre -->

    <owl:Class rdf:about="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#Ordre">
        <rdfs:subClassOf rdf:resource="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#Taxon"/>
        <rdfs:comment xml:lang="fr">Niveau botanique correspondant au terme usuel de « sous-sous-groupe » (ex. Ericales, Fabales).</rdfs:comment>
        <rdfs:label xml:lang="fr">Ordre</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/burkina-environnement#PartiePlante -->

    <owl:Class rdf:about="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#PartiePlante">
        <rdfs:comment xml:lang="fr">Partie de la plante utilisee : feuille, ecorce, racine, fruit, graine, fleur, amande. Synonyme : Organe.</rdfs:comment>
        <rdfs:label xml:lang="fr">PartiePlante</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/burkina-environnement#Pathologie -->

    <owl:Class rdf:about="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#Pathologie">
        <rdfs:comment xml:lang="fr">Maladie ou trouble traditionnellement traite par un usage medicinal (ex. paludisme). Synonyme : Maladie.</rdfs:comment>
        <rdfs:label xml:lang="fr">Pathologie</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/burkina-environnement#Photo -->

    <owl:Class rdf:about="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#Photo">
        <rdfs:subClassOf rdf:resource="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#Media"/>
        <rdfs:comment xml:lang="fr">Image fixe.</rdfs:comment>
        <rdfs:label xml:lang="fr">Photo</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/burkina-environnement#PointRemarquable -->

    <owl:Class rdf:about="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#PointRemarquable">
        <rdfs:comment xml:lang="fr">Point servant notamment a representer une source ou un point de versement.</rdfs:comment>
        <rdfs:label xml:lang="fr">PointRemarquable</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/burkina-environnement#Province -->

    <owl:Class rdf:about="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#Province">
        <rdfs:subClassOf rdf:resource="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#Localite"/>
        <rdfs:comment xml:lang="fr">Echelon intermediaire (47 provinces) ; appartient a une region. Synonyme : Circonscription provinciale.</rdfs:comment>
        <rdfs:label xml:lang="fr">Province</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/burkina-environnement#Quartier -->

    <owl:Class rdf:about="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#Quartier">
        <rdfs:subClassOf rdf:resource="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#Localite"/>
        <rdfs:comment xml:lang="fr">Subdivision d&apos;un secteur en milieu urbain. Synonyme : Cellule d&apos;un secteur.</rdfs:comment>
        <rdfs:label xml:lang="fr">Quartier</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/burkina-environnement#Region -->

    <owl:Class rdf:about="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#Region">
        <rdfs:subClassOf rdf:resource="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#Localite"/>
        <rdfs:comment xml:lang="fr">Deuxieme niveau du decoupage administratif, rattache au Pays (17 regions depuis le decret du 2 juillet 2025, aux toponymes endogenes : Bankui, Guiriko, Kadiogo, Liptako...). Synonyme : Circonscription regionale.</rdfs:comment>
        <rdfs:label xml:lang="fr">Region</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/burkina-environnement#Regne -->

    <owl:Class rdf:about="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#Regne">
        <rdfs:subClassOf rdf:resource="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#Taxon"/>
        <rdfs:comment xml:lang="fr">Plus haut rang de la classification (Plantae).</rdfs:comment>
        <rdfs:label xml:lang="fr">Regne</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/burkina-environnement#Riviere -->

    <owl:Class rdf:about="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#Riviere">
        <rdfs:subClassOf rdf:resource="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#CoursEau"/>
        <rdfs:comment xml:lang="fr">Ex. Comoe, Leraba, Pendjari, Sirba...</rdfs:comment>
        <rdfs:label xml:lang="fr">Riviere</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/burkina-environnement#Secteur -->

    <owl:Class rdf:about="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#Secteur">
        <rdfs:subClassOf rdf:resource="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#Localite"/>
        <rdfs:comment xml:lang="fr">Subdivision d&apos;un arrondissement ; regroupe des quartiers. Synonyme : Cellule urbaine de base.</rdfs:comment>
        <rdfs:label xml:lang="fr">Secteur</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/burkina-environnement#SousBassin -->

    <owl:Class rdf:about="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#SousBassin">
        <rdfs:subClassOf rdf:resource="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#UniteHydrographique"/>
        <rdfs:comment xml:lang="fr">Sous-bassin (Mouhoun, Nakanbe, Niger, Comoe). Synonyme : Sous-groupe.</rdfs:comment>
        <rdfs:label xml:lang="fr">SousBassin</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/burkina-environnement#SousGroupeZoologique -->

    <owl:Class rdf:about="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#SousGroupeZoologique">
        <rdfs:subClassOf rdf:resource="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#Taxon"/>
        <rdfs:comment xml:lang="fr">Second niveau (ex. Carnivores). Synonyme : Sous-groupe.</rdfs:comment>
        <rdfs:label xml:lang="fr">SousGroupeZoologique</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/burkina-environnement#SousSousGroupeZoologique -->

    <owl:Class rdf:about="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#SousSousGroupeZoologique">
        <rdfs:subClassOf rdf:resource="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#Taxon"/>
        <rdfs:comment xml:lang="fr">Troisieme niveau (ex. Felins). Synonyme : Sous-sous-groupe.</rdfs:comment>
        <rdfs:label xml:lang="fr">SousSousGroupeZoologique</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/burkina-environnement#StatutConservation -->

    <owl:Class rdf:about="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#StatutConservation">
        <rdfs:comment xml:lang="fr">Niveau de menace pesant sur une espece selon la classification UICN (LC, NT, VU, EN, CR, EW, EX). Synonyme : Statut UICN.</rdfs:comment>
        <rdfs:label xml:lang="fr">StatutConservation</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/burkina-environnement#Taxon -->

    <owl:Class rdf:about="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#Taxon">
        <rdfs:comment xml:lang="fr">Classe mere de tout niveau de classification scientifique du vivant ; les rangs botaniques et zoologiques en sont des sous-classes.</rdfs:comment>
        <rdfs:label xml:lang="fr">Taxon</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/burkina-environnement#TypeCulture -->

    <owl:Class rdf:about="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#TypeCulture">
        <rdfs:comment xml:lang="fr">Type de culture adapte : parc agroforestier, culture pluviale, plantation/verger, protection dans les champs, gommeraie amenagee, maraichage, irriguee. Synonyme : Mode de conduite.</rdfs:comment>
        <rdfs:label xml:lang="fr">TypeCulture</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/burkina-environnement#UniteElementaire -->

    <owl:Class rdf:about="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#UniteElementaire">
        <rdfs:subClassOf rdf:resource="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#UniteHydrographique"/>
        <rdfs:comment xml:lang="fr">Unite elementaire d&apos;un sous-bassin. Synonyme : Sous-sous-groupe.</rdfs:comment>
        <rdfs:label xml:lang="fr">UniteElementaire</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/burkina-environnement#UniteHydrographique -->

    <owl:Class rdf:about="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#UniteHydrographique">
        <rdfs:comment xml:lang="fr">Classe racine des unites de classement hydrographique.</rdfs:comment>
        <rdfs:label xml:lang="fr">UniteHydrographique</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/burkina-environnement#Usage -->

    <owl:Class rdf:about="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#Usage">
        <rdfs:comment xml:lang="fr">Type d&apos;usage d&apos;une espece ; un individu Usage est cree par couple (espece, type d&apos;usage). Synonyme : Utilite.</rdfs:comment>
        <rdfs:label xml:lang="fr">Usage</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/burkina-environnement#UsageAlimentaire -->

    <owl:Class rdf:about="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#UsageAlimentaire">
        <rdfs:subClassOf rdf:resource="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#Usage"/>
        <rdfs:comment xml:lang="fr">Synonyme : Comestible.</rdfs:comment>
        <rdfs:label xml:lang="fr">UsageAlimentaire</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/burkina-environnement#UsageArtisanal -->

    <owl:Class rdf:about="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#UsageArtisanal">
        <rdfs:subClassOf rdf:resource="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#Usage"/>
        <rdfs:comment xml:lang="fr">Synonyme : Utilitaire/Artisanat (extension : gomme arabique, beurre de karite...).</rdfs:comment>
        <rdfs:label xml:lang="fr">UsageArtisanal</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/burkina-environnement#UsageMedicinal -->

    <owl:Class rdf:about="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#UsageMedicinal">
        <rdfs:subClassOf rdf:resource="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#Usage"/>
        <rdfs:comment xml:lang="fr">Synonyme : Medicinale.</rdfs:comment>
        <rdfs:label xml:lang="fr">UsageMedicinal</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/burkina-environnement#UsageOrnemental -->

    <owl:Class rdf:about="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#UsageOrnemental">
        <rdfs:subClassOf rdf:resource="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#Usage"/>
        <rdfs:comment xml:lang="fr">Synonyme : Ornementale.</rdfs:comment>
        <rdfs:label xml:lang="fr">UsageOrnemental</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/burkina-environnement#Video -->

    <owl:Class rdf:about="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#Video">
        <rdfs:subClassOf rdf:resource="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#Media"/>
        <rdfs:comment xml:lang="fr">Sequence audiovisuelle (ex. technique de preparation, rythme joue).</rdfs:comment>
        <rdfs:label xml:lang="fr">Video</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/burkina-environnement#Village -->

    <owl:Class rdf:about="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#Village">
        <rdfs:subClassOf rdf:resource="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#Localite"/>
        <rdfs:comment xml:lang="fr">Plus petite circonscription en milieu rural, rattachee a une commune rurale. Synonyme : Cellule rurale de base.</rdfs:comment>
        <rdfs:label xml:lang="fr">Village</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/burkina-environnement#ZoneClimatique -->

    <owl:Class rdf:about="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#ZoneClimatique">
        <rdfs:comment xml:lang="fr">Zone climatique du Burkina Faso : sahelienne, soudano-sahelienne, soudanienne (bornes de pluviometrie).</rdfs:comment>
        <rdfs:label xml:lang="fr">ZoneClimatique</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/burkina-environnement#ZoneSahelienne -->

    <owl:Class rdf:about="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#ZoneSahelienne">
        <rdfs:subClassOf rdf:resource="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#ZoneClimatique"/>
        <rdfs:comment xml:lang="fr">Sous-classe de ZoneClimatique regroupant les individus de type climat sahelien. Introduite pour permettre l&apos;evaluation de la regle R-F5 (espece strategique pour la securite alimentaire).</rdfs:comment>
        <rdfs:label xml:lang="fr">ZoneSahelienne</rdfs:label>
    </owl:Class>
    



    



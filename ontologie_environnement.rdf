        <rdfs:label xml:lang="fr">dureeVideo</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/burkina-environnement#dureeVieMoyenne -->

    <owl:DatatypeProperty rdf:about="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#dureeVieMoyenne">
        <rdfs:domain rdf:resource="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#EspeceAnimale"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment xml:lang="fr">Duree de vie moyenne en annees.</rdfs:comment>
        <rdfs:label xml:lang="fr">dureeVieMoyenne</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/burkina-environnement#echelleCarteSpatiale -->

    <owl:DatatypeProperty rdf:about="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#echelleCarteSpatiale">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#CarteSpatiale"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="fr">Niveau de detail utilise pour afficher la carte.</rdfs:comment>
        <rdfs:label xml:lang="fr">echelleCarteSpatiale</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/burkina-environnement#estPrioritaire -->

    <owl:DatatypeProperty rdf:about="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#estPrioritaire">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#EspeceAnimale"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="fr">Espece prioritaire en conservation - propriete inferee par regle SWRL, jamais saisie.</rdfs:comment>
        <rdfs:label xml:lang="fr">estPrioritaire</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/burkina-environnement#geometrieWKT -->

    <owl:DatatypeProperty rdf:about="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#geometrieWKT">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#CoursEau"/>
                    <rdf:Description rdf:about="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#Localite"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="fr">Geometrie au format WKT (GeoSPARQL), restreinte a Localite et CoursEau pour ce lot. Le range est exprime en xsd:string (type XSD standard) pour permettre la validation de coherence par le raisonneur HermiT ; la conversion vers geo:wktLiteral se fait a l&apos;interrogation via STRDT.</rdfs:comment>
        <rdfs:label xml:lang="fr">geometrieWKT</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/burkina-environnement#hauteurEau -->

    <owl:DatatypeProperty rdf:about="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#hauteurEau">
        <rdfs:domain rdf:resource="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#CaracteristiqueHydrologique"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment xml:lang="fr">Hauteur d&apos;eau en metres.</rdfs:comment>
        <rdfs:label xml:lang="fr">hauteurEau</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/burkina-environnement#hauteurMoyenne -->

    <owl:DatatypeProperty rdf:about="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#hauteurMoyenne">

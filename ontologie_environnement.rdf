        <rdfs:range rdf:resource="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#EspeceVegetale"/>
        <rdfs:comment xml:lang="fr">Espece(s) associee(s) a cet usage.</rdfs:comment>
        <rdfs:label xml:lang="fr">usageDe</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/burkina-environnement#utilisePartie -->

    <owl:ObjectProperty rdf:about="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#utilisePartie">
        <rdfs:domain rdf:resource="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#Usage"/>
        <rdfs:range rdf:resource="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#PartiePlante"/>
        <rdfs:comment xml:lang="fr">Partie(s) de la plante mobilisee(s) par cet usage. Cardinalite : 0..*.</rdfs:comment>
        <rdfs:label xml:lang="fr">utilisePartie</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/burkina-environnement#vitDans -->

    <owl:ObjectProperty rdf:about="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#vitDans">

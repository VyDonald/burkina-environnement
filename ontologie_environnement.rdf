        <rdfs:comment xml:lang="fr">Description des conditions de culture.</rdfs:comment>
        <rdfs:label xml:lang="fr">conditionCulture</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/burkina-environnement#dateCreation -->

    <owl:DatatypeProperty rdf:about="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#dateCreation">

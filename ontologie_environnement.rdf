    <swrl:Imp rdf:about="http://www.ibam-ujkz.bf/ontologies/burkina-environnement#regle_RA1a">
        <rdfs:comment xml:lang="fr">Transitivite de aPourTaxonParent : remontee complete de la hierarchie taxonomique.</rdfs:comment>
        <swrl:body rdf:parseType="Collection">
            <swrl:IndividualPropertyAtom>

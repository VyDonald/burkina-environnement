        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="fr">Code officiel de l&apos;entite (nomenclature INSD).</rdfs:comment>
        <rdfs:label xml:lang="fr">codeLocalite</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/burkina-environnement#codeUICN -->


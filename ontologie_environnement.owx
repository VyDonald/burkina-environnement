    </Annotation>
    <Annotation>
        <AnnotationProperty abbreviatedIRI="dcterms:creator"/>
        <Literal xml:lang="fr">Groupe Environnement (Flore : Gr.1,21,28 ; Faune : Gr.25,35 ; Cours d&apos;eau : Gr.7,14) - IBAM/UJKZ</Literal>
    </Annotation>
    <Annotation>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <Literal xml:lang="fr">Ontologie du lot Environnement (fusion des theme Flore, Faune, Cours d&apos;eau) du systeme OntoBurkina, restreinte a ce lot conformement aux instructions de fusion par lot. Concepts pivots partages avec les autres lots : Ethnie et Localite. Base sur le cahier des charges technique commun OntoBurkina et peuplee avec les donnees reelles collectees (Collecte_Donnees_OntoBurkina.xlsx).</Literal>
    </Annotation>
    <Annotation>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <Literal xml:lang="fr">OntoBurkina-Environnement</Literal>
    </Annotation>
    <Annotation>
        <AnnotationProperty abbreviatedIRI="owl:versionInfo"/>
        <Literal>1.0 - lot Environnement, peuple depuis Collecte_Donnees_OntoBurkina.xlsx</Literal>
    </Annotation>

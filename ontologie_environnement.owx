    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#AireGeographique</IRI>
        <Literal xml:lang="fr">Emprise geographique reelle d&apos;une communaute, d&apos;une langue ou d&apos;un phenomene, distincte des limites administratives. Synonyme : Zone d&apos;implantation.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#AireGeographique</IRI>
        <Literal xml:lang="fr">AireGeographique</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#Appellation</IRI>
        <Literal xml:lang="fr">Nom officiel, nom local ou appellation alternative d&apos;un cours d&apos;eau (ex. Volta Noire pour le Mouhoun). Synonyme : Nom local.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#Appellation</IRI>
        <Literal xml:lang="fr">Appellation</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#Arrondissement</IRI>
        <Literal xml:lang="fr">Subdivision des communes urbaines a statut particulier ; regroupe des secteurs. Synonyme : Subdivision communale.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#Arrondissement</IRI>
        <Literal xml:lang="fr">Arrondissement</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#BassinVersant</IRI>
        <Literal xml:lang="fr">Grand bassin (Volta, Niger, Comoe). Synonyme : Groupe.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#BassinVersant</IRI>
        <Literal xml:lang="fr">BassinVersant</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#CaracteristiqueHydrologique</IRI>
        <Literal xml:lang="fr">Debit moyen, hauteur d&apos;eau, periode de crue ou autre caracteristique mesuree, datee et sourcee. Synonyme : Mesure.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#CaracteristiqueHydrologique</IRI>
        <Literal xml:lang="fr">CaracteristiqueHydrologique</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#CarteSpatiale</IRI>
        <Literal xml:lang="fr">Representation permettant de localiser les elements de l&apos;ontologie sur le territoire (echelle, projection). Synonymes : Carte geographique, Geolocalisation.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#CarteSpatiale</IRI>
        <Literal xml:lang="fr">CarteSpatiale</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#ClasseBotanique</IRI>
        <Literal xml:lang="fr">Niveau botanique correspondant au terme usuel de « sous-groupe » (ex. Dicotyledones).</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#ClasseBotanique</IRI>
        <Literal xml:lang="fr">ClasseBotanique</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#Commune</IRI>
        <Literal xml:lang="fr">Collectivite territoriale rattachee a un departement ; urbaine ou rurale. Synonymes : Circonscription territoriale, Municipalite.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#Commune</IRI>
        <Literal xml:lang="fr">Commune</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#CommuneRurale</IRI>
        <Literal xml:lang="fr">Regroupe des villages. Synonyme : Municipalite rurale.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#CommuneRurale</IRI>
        <Literal xml:lang="fr">CommuneRurale</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#CommuneUrbaine</IRI>
        <Literal xml:lang="fr">Agglomeration d&apos;au moins 10 000 habitants ; subdivisee en arrondissements (Ouagadougou, Bobo-Dioulasso). Synonyme : Municipalite urbaine.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#CommuneUrbaine</IRI>
        <Literal xml:lang="fr">CommuneUrbaine</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#CoursEau</IRI>
        <Literal xml:lang="fr">Classe racine des entites hydrographiques : ecoulement d&apos;eaux courantes dans un lit naturel, alimente par une source. Les eaux stagnantes (lacs, mares, barrages) sont hors perimetre.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#CoursEau</IRI>
        <Literal xml:lang="fr">CoursEau</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#Departement</IRI>
        <Literal xml:lang="fr">Circonscription de base de l&apos;Etat (350), placee sous l&apos;autorite d&apos;un prefet ; appartient a une province. Synonyme : Circonscription departementale.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#Departement</IRI>
        <Literal xml:lang="fr">Departement</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#Embranchement</IRI>
        <Literal xml:lang="fr">Niveau botanique correspondant au terme usuel de « groupe » (ex. Angiospermes).</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#Embranchement</IRI>
        <Literal xml:lang="fr">Embranchement</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#EspeceAnimale</IRI>
        <Literal xml:lang="fr">Espece animale observee au Burkina Faso, identifiee par son nom scientifique ; classe centrale de ce theme.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#EspeceAnimale</IRI>
        <Literal xml:lang="fr">EspeceAnimale</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#EspeceMultiUsage</IRI>
        <Literal xml:lang="fr">Espece vegetale a la fois alimentaire et medicinale. Classe inferee par la regle SWRL R-F3.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#EspeceMultiUsage</IRI>
        <Literal xml:lang="fr">EspeceMultiUsage</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#EspeceStrategiqueSecuriteAlimentaire</IRI>
        <Literal xml:lang="fr">Espece alimentaire adaptee a la zone sahelienne. Classe inferee par la regle SWRL R-F5.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#EspeceStrategiqueSecuriteAlimentaire</IRI>
        <Literal xml:lang="fr">EspeceStrategiqueSecuriteAlimentaire</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#EspeceVegetale</IRI>
        <Literal xml:lang="fr">Espece vegetale recensee au Burkina Faso, identifiee par son nom scientifique binomial ; classe centrale de ce theme.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#EspeceVegetale</IRI>
        <Literal xml:lang="fr">EspeceVegetale</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#Ethnie</IRI>
        <Literal xml:lang="fr">Groupe de personnes partageant une meme culture, une langue et des traditions (culinaires, musicales...). Concept pivot de la fusion. Synonymes : GroupeEthnique, Peuple, Communaute.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#Ethnie</IRI>
        <Literal xml:lang="fr">Ethnie</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#FamilleBotanique</IRI>
        <Literal xml:lang="fr">Famille rattachee a un ordre (ex. Sapotaceae, Fabaceae). Synonyme : Famille.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#FamilleBotanique</IRI>
        <Literal xml:lang="fr">FamilleBotanique</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#FamilleZoologique</IRI>
        <Literal xml:lang="fr">Niveau le plus fin (ex. Felides, Elephantides). Synonyme : Famille.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#FamilleZoologique</IRI>
        <Literal xml:lang="fr">FamilleZoologique</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#Fleuve</IRI>
        <Literal xml:lang="fr">Ex. Mouhoun, Nakanbe, Nazinon.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#Fleuve</IRI>
        <Literal xml:lang="fr">Fleuve</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#GroupeZoologique</IRI>
        <Literal xml:lang="fr">Niveau superieur de la classification zoologique (ex. Mammiferes). Synonyme : Groupe.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#GroupeZoologique</IRI>
        <Literal xml:lang="fr">GroupeZoologique</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#Localite</IRI>
        <Literal xml:lang="fr">Classe racine de toute subdivision du territoire ; regroupe les caracteristiques communes (nom, code, population, superficie, coordonnees). Lieu ou un element du patrimoine est situe, prepare, parle, joue, observe ou recense.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#Localite</IRI>
        <Literal xml:lang="fr">Localite</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#Marigot</IRI>
        <Literal xml:lang="fr">Ecoulement local, souvent saisonnier.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#Marigot</IRI>
        <Literal xml:lang="fr">Marigot</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#Media</IRI>
        <Literal xml:lang="fr">Representation visuelle ou audiovisuelle illustrant un element de l&apos;ontologie.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#Media</IRI>
        <Literal xml:lang="fr">Media</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#MilieuDeVie</IRI>
        <Literal xml:lang="fr">Type d&apos;environnement dans lequel evolue une espece : aerien, aquatique, terrestre. Synonyme : Milieu.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#MilieuDeVie</IRI>
        <Literal xml:lang="fr">MilieuDeVie</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#ModePreparation</IRI>
        <Literal xml:lang="fr">Decoction, infusion, maceration, poudre, cataplasme.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#ModePreparation</IRI>
        <Literal xml:lang="fr">ModePreparation</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#Ordre</IRI>
        <Literal xml:lang="fr">Niveau botanique correspondant au terme usuel de « sous-sous-groupe » (ex. Ericales, Fabales).</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#Ordre</IRI>
        <Literal xml:lang="fr">Ordre</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#PartiePlante</IRI>
        <Literal xml:lang="fr">Partie de la plante utilisee : feuille, ecorce, racine, fruit, graine, fleur, amande. Synonyme : Organe.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#PartiePlante</IRI>
        <Literal xml:lang="fr">PartiePlante</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#Pathologie</IRI>
        <Literal xml:lang="fr">Maladie ou trouble traditionnellement traite par un usage medicinal (ex. paludisme). Synonyme : Maladie.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#Pathologie</IRI>
        <Literal xml:lang="fr">Pathologie</Literal>
    </AnnotationAssertion>

                <Variable IRI="urn:swrl:var#b"/>
                <Variable IRI="urn:swrl:var#c2"/>
            </ObjectPropertyAtom>
        </Head>
    </DLSafeRule>
    <DLSafeRule about="#regle_RN3">
        <Annotation>
            <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
            <Literal xml:lang="fr">Un cours d&apos;eau traversant une entite administrative la traverse aussi dans ses entites contenues.</Literal>
        </Annotation>
        <Body>
            <ObjectPropertyAtom>
                <ObjectProperty IRI="#traverse"/>
                <Variable IRI="urn:swrl:var#x"/>
                <Variable IRI="urn:swrl:var#l"/>
            </ObjectPropertyAtom>
            <ObjectPropertyAtom>
                <ObjectProperty IRI="#contient"/>
                <Variable IRI="urn:swrl:var#l"/>
                <Variable IRI="urn:swrl:var#z"/>
            </ObjectPropertyAtom>
        </Body>
        <Head>
            <ObjectPropertyAtom>
                <ObjectProperty IRI="#traverse"/>
                <Variable IRI="urn:swrl:var#x"/>
                <Variable IRI="urn:swrl:var#z"/>
            </ObjectPropertyAtom>
        </Head>
    </DLSafeRule>

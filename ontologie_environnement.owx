        <Literal xml:lang="fr">Point servant notamment a representer une source ou un point de versement.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#PointRemarquable</IRI>

    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#Region</IRI>
        <Literal xml:lang="fr">Deuxieme niveau du decoupage administratif, rattache au Pays (17 regions depuis le decret du 2 juillet 2025, aux toponymes endogenes : Bankui, Guiriko, Kadiogo, Liptako...). Synonyme : Circonscription regionale.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#Region</IRI>
        <Literal xml:lang="fr">Region</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>

    <!-- Geometries WKT (WGS84) des localites d'observation (aires protegees du Burkina Faso).
         Coordonnees approximatives (centroides, sources publiques). POINT = (longitude latitude).
         Alimentent les requetes spatiales GeoSPARQL de la carte (geof:distance autour d'une localite). -->

    <DataPropertyAssertion>
        <DataProperty IRI="#latitude"/>
        <NamedIndividual IRI="#localite_complexe_w_arly_pendjari_wap"/>
        <Literal datatypeIRI="http://www.w3.org/2001/XMLSchema#decimal">11.90</Literal>
    </DataPropertyAssertion>
    <DataPropertyAssertion>
        <DataProperty IRI="#longitude"/>
        <NamedIndividual IRI="#localite_complexe_w_arly_pendjari_wap"/>
        <Literal datatypeIRI="http://www.w3.org/2001/XMLSchema#decimal">1.90</Literal>
    </DataPropertyAssertion>
    <DataPropertyAssertion>
        <DataProperty IRI="#geometrieWKT"/>
        <NamedIndividual IRI="#localite_complexe_w_arly_pendjari_wap"/>
        <Literal>POINT (1.90 11.90)</Literal>
    </DataPropertyAssertion>
    <DataPropertyAssertion>
        <DataProperty IRI="#latitude"/>
        <NamedIndividual IRI="#localite_mare_aux_crocodiles_de_bazoule"/>
        <Literal datatypeIRI="http://www.w3.org/2001/XMLSchema#decimal">12.24</Literal>
    </DataPropertyAssertion>
    <DataPropertyAssertion>

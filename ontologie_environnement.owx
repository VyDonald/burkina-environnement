    <DLSafeRule about="#regle_RA1a">
        <Annotation>
            <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
            <Literal xml:lang="fr">Transitivite de aPourTaxonParent : remontee complete de la hierarchie taxonomique.</Literal>
        </Annotation>
        <Body>
            <ObjectPropertyAtom>
                <ObjectProperty IRI="#aPourTaxonParent"/>
                <Variable IRI="urn:swrl:var#x"/>
                <Variable IRI="urn:swrl:var#y"/>
            </ObjectPropertyAtom>
            <ObjectPropertyAtom>
                <ObjectProperty IRI="#aPourTaxonParent"/>
                <Variable IRI="urn:swrl:var#y"/>
                <Variable IRI="urn:swrl:var#z"/>
            </ObjectPropertyAtom>
        </Body>
        <Head>
            <ObjectPropertyAtom>
                <ObjectProperty IRI="#aPourTaxonParent"/>
                <Variable IRI="urn:swrl:var#x"/>
                <Variable IRI="urn:swrl:var#z"/>
            </ObjectPropertyAtom>
        </Head>
    </DLSafeRule>
    <DLSafeRule about="#regle_RA1b">
        <Annotation>
            <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
            <Literal xml:lang="fr">Transitivite de contient : hierarchie territoriale (regions, provinces, localites).</Literal>
        </Annotation>
        <Body>
            <ObjectPropertyAtom>
                <ObjectProperty IRI="#contient"/>
                <Variable IRI="urn:swrl:var#x"/>
                <Variable IRI="urn:swrl:var#y"/>
            </ObjectPropertyAtom>
            <ObjectPropertyAtom>
                <ObjectProperty IRI="#contient"/>
                <Variable IRI="urn:swrl:var#y"/>
                <Variable IRI="urn:swrl:var#z"/>
            </ObjectPropertyAtom>
        </Body>
        <Head>
            <ObjectPropertyAtom>
                <ObjectProperty IRI="#contient"/>
                <Variable IRI="urn:swrl:var#x"/>
                <Variable IRI="urn:swrl:var#z"/>
            </ObjectPropertyAtom>
        </Head>
    </DLSafeRule>
    <DLSafeRule about="#regle_RA2">
        <Annotation>
            <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
            <Literal xml:lang="fr">Transitivite de aPourAffluent : hierarchie du reseau hydrographique.</Literal>
        </Annotation>
        <Body>
            <ObjectPropertyAtom>
                <ObjectProperty IRI="#aPourAffluent"/>
                <Variable IRI="urn:swrl:var#x"/>
                <Variable IRI="urn:swrl:var#y"/>
            </ObjectPropertyAtom>
            <ObjectPropertyAtom>
                <ObjectProperty IRI="#aPourAffluent"/>
                <Variable IRI="urn:swrl:var#y"/>
                <Variable IRI="urn:swrl:var#z"/>
            </ObjectPropertyAtom>
        </Body>
        <Head>
            <ObjectPropertyAtom>
                <ObjectProperty IRI="#aPourAffluent"/>
                <Variable IRI="urn:swrl:var#x"/>
                <Variable IRI="urn:swrl:var#z"/>
            </ObjectPropertyAtom>
        </Head>
    </DLSafeRule>
    <DLSafeRule about="#regle_RE1">
        <Annotation>
            <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
            <Literal xml:lang="fr">Ordre botanique remonte comme parent taxonomique de la famille.</Literal>
        </Annotation>
        <Body>
            <ObjectPropertyAtom>
                <ObjectProperty IRI="#appartientAOrdre"/>
                <Variable IRI="urn:swrl:var#f"/>
                <Variable IRI="urn:swrl:var#o"/>
            </ObjectPropertyAtom>
        </Body>
        <Head>
            <ObjectPropertyAtom>
                <ObjectProperty IRI="#aPourTaxonParent"/>
                <Variable IRI="urn:swrl:var#f"/>
                <Variable IRI="urn:swrl:var#o"/>
            </ObjectPropertyAtom>
        </Head>
    </DLSafeRule>
    <DLSafeRule about="#regle_RF1">
        <Annotation>
            <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
            <Literal xml:lang="fr">Classe botanique remontee comme parent taxonomique de l&apos;ordre.</Literal>
        </Annotation>
        <Body>
            <ObjectPropertyAtom>
                <ObjectProperty IRI="#appartientAClasseBotanique"/>
                <Variable IRI="urn:swrl:var#o"/>
                <Variable IRI="urn:swrl:var#c"/>
            </ObjectPropertyAtom>
        </Body>
        <Head>
            <ObjectPropertyAtom>
                <ObjectProperty IRI="#aPourTaxonParent"/>
                <Variable IRI="urn:swrl:var#o"/>
                <Variable IRI="urn:swrl:var#c"/>
            </ObjectPropertyAtom>
        </Head>
    </DLSafeRule>
    <DLSafeRule about="#regle_RF2">
        <Annotation>
            <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
            <Literal xml:lang="fr">Embranchement remonte comme parent taxonomique de la classe botanique.</Literal>
        </Annotation>
        <Body>
            <ObjectPropertyAtom>
                <ObjectProperty IRI="#appartientAEmbranchement"/>
                <Variable IRI="urn:swrl:var#c"/>
                <Variable IRI="urn:swrl:var#em"/>
            </ObjectPropertyAtom>
        </Body>
        <Head>
            <ObjectPropertyAtom>
                <ObjectProperty IRI="#aPourTaxonParent"/>
                <Variable IRI="urn:swrl:var#c"/>
                <Variable IRI="urn:swrl:var#em"/>
            </ObjectPropertyAtom>
        </Head>
    </DLSafeRule>
    <DLSafeRule about="#regle_RF3">
        <Annotation>
            <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
            <Literal xml:lang="fr">Regne remonte comme parent taxonomique de l&apos;embranchement.</Literal>
        </Annotation>
        <Body>
            <ObjectPropertyAtom>
                <ObjectProperty IRI="#appartientARegne"/>
                <Variable IRI="urn:swrl:var#em"/>
                <Variable IRI="urn:swrl:var#r"/>
            </ObjectPropertyAtom>
        </Body>
        <Head>
            <ObjectPropertyAtom>
                <ObjectProperty IRI="#aPourTaxonParent"/>
                <Variable IRI="urn:swrl:var#em"/>
                <Variable IRI="urn:swrl:var#r"/>
            </ObjectPropertyAtom>
        </Head>
    </DLSafeRule>
    <DLSafeRule about="#regle_RF4">
        <Annotation>
            <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
            <Literal xml:lang="fr">Zone climatique deduite de la localite d&apos;observation de l&apos;espece vegetale.</Literal>
        </Annotation>
        <Body>
            <ClassAtom>
                <Class IRI="#EspeceVegetale"/>
                <Variable IRI="urn:swrl:var#s"/>
            </ClassAtom>
            <ObjectPropertyAtom>
                <ObjectProperty IRI="#estPresenteDans"/>
                <Variable IRI="urn:swrl:var#s"/>
                <Variable IRI="urn:swrl:var#l"/>
            </ObjectPropertyAtom>
            <ObjectPropertyAtom>
                <ObjectProperty IRI="#aPourZoneClimatique"/>
                <Variable IRI="urn:swrl:var#l"/>
                <Variable IRI="urn:swrl:var#z2"/>
            </ObjectPropertyAtom>
        </Body>
        <Head>
            <ObjectPropertyAtom>
                <ObjectProperty IRI="#appartientAZoneClimatique"/>
                <Variable IRI="urn:swrl:var#s"/>
                <Variable IRI="urn:swrl:var#z2"/>
            </ObjectPropertyAtom>
        </Head>
    </DLSafeRule>
    <DLSafeRule about="#regle_RF5">
        <Annotation>
            <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
            <Literal xml:lang="fr">Cours d&apos;eau rattache au bassin versant via son sous-bassin.</Literal>
        </Annotation>
        <Body>
            <ObjectPropertyAtom>
                <ObjectProperty IRI="#aPourSousBassin"/>
                <Variable IRI="urn:swrl:var#b"/>

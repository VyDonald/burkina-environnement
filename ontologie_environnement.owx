        <Literal xml:lang="fr">Ex. Comoe, Leraba, Pendjari, Sirba...</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#Riviere</IRI>
        <Literal xml:lang="fr">Riviere</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#Secteur</IRI>
        <Literal xml:lang="fr">Subdivision d&apos;un arrondissement ; regroupe des quartiers. Synonyme : Cellule urbaine de base.</Literal>
    </AnnotationAssertion>

        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#Province</IRI>
        <Literal xml:lang="fr">Echelon intermediaire (47 provinces) ; appartient a une region. Synonyme : Circonscription provinciale.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#Province</IRI>
        <Literal xml:lang="fr">Province</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#Quartier</IRI>
        <Literal xml:lang="fr">Subdivision d&apos;un secteur en milieu urbain. Synonyme : Cellule d&apos;un secteur.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#Quartier</IRI>
